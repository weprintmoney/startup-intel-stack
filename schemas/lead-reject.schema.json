{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YOUR_ORG/YOUR_REPO/schemas/lead-reject.schema.json",
  "title": "Pre-filtered lead (rejected)",
  "description": "leads/pre-filtered/*-rejects.json — a lead-deduped record that failed pre-filter's structural gate. Diverges from lead-pre-filtered.schema.json: no eu_flagged/mql_score/title_match requirement (the gate can reject before those are computed), and reject_reason is required instead.",
  "type": "object",
  "required": [
    "company_name", "website", "employee_count", "industry", "contact_name",
    "contact_title", "linkedin_url", "icp_segment", "icp_rationale", "country_code",
    "source", "prior_contact", "pre_filter_passed", "pre_filter_date", "reject_reason"
  ],
  "additionalProperties": false,
  "properties": {
    "company_name": { "type": "string" },
    "website": { "type": "string" },
    "employee_count": { "type": "integer", "minimum": 0 },
    "industry": { "type": "string" },
    "contact_name": { "type": "string" },
    "contact_title": { "type": "string" },
    "linkedin_url": { "type": "string" },
    "icp_segment": { "type": "string" },
    "icp_rationale": { "type": "string" },
    "country_code": { "type": "string" },
    "source": { "type": "string" },
    "prior_contact": { "type": "boolean" },
    "pre_filter_passed": { "const": false },
    "pre_filter_date": { "type": "string", "format": "date" },
    "reject_reason": { "type": "string" },
    "eu_flagged": { "type": "boolean" },
    "icp_score": { "type": "number" },
    "target_product": { "type": "string" },
    "funding_stage": { "type": "string" },
    "funding_date": { "type": "string", "format": "date" },
    "funding_amount": { "type": "string" },
    "announcement_link": { "type": "string" },
    "event_slug": { "type": "string" },
    "apollo_id": { "type": "string" }
  }
}
