# sales-ops secrets & variables
#
# GitHub Actions reads these from repo Secrets and repo Variables. This
# file is documentation — never commit a filled copy.
#
# ==========================================================================
# Anthropic
# ==========================================================================

# Every LLM-agent workflow (crawler, event-ingest, dedup, pre-filter,
# enrichment, stack-profile, qualifier-critic, copy-evaluator,
# sequence-enrollment, evergreen-nurture, feedback-loop, judge-evals).
# Dedicated key so cost reporting can attribute spend cleanly.
# Read by: weekly-crawl, event-ingest, pre-filter, enrichment,
#          stack-profile, dedup-review, sequence-enrollment,
#          evergreen-nurture, feedback-loop, judge-evals
ANTHROPIC_API_KEY=

# ==========================================================================
# Data providers
# ==========================================================================

# Apollo.io — used for the weekly crawl and email enrichment.
# Read by: weekly-crawl.yml, enrichment.yml
APOLLO_API_KEY=

# Hunter.io — email finder + verifier fallback when Apollo doesn't match.
# Read by: enrichment.yml
HUNTERIO_API_KEY=

# Exa — neural search for signal research (funding, hiring, pain quotes)
# and stack-profile evidence (GitHub, job posts, engineering blogs).
# Falls back to Anthropic WebSearch when unset.
# Read by: enrichment.yml, stack-profile.yml
EXA_API_KEY=

# ==========================================================================
# CRM (Attio)
# ==========================================================================

# Attio API key. Prior-contact dedup, upsert-as-pending on qualifier-critic
# PASS, sequence-status writes on send, reply-monitor updates.
# Read by: dedup.yml, dedup-review.yml, sequence-enrollment.yml,
#          smtp-send.yml, reply-monitor.yml, evergreen-nurture.yml,
#          attio-schema-setup.yml, attio-dedup-check.yml, event-ingest.yml
ATTIO_API_KEY=

# Attio inbound-BCC logging address — smtp-send BCCs every send here so
# the thread appears on the CRM record without an SMTP-side sync.
# Read by: smtp-send.yml
ATTIO_BCC_ADDRESS=

# ==========================================================================
# Send path (Resend)
# ==========================================================================

# Resend API key for mail.<your-send-domain>.
# Read by: smtp-send.yml, warmup.yml
RESEND_API_KEY=

# Optional from-address override; defaults to outreach@mail.<domain>.
# Read by: smtp-send.yml, warmup.yml
RESEND_FROM=

# Comma-separated seed addresses for the 28-day domain warmup ramp.
# Read by: warmup.yml
WARMUP_SEED_ADDRESSES=

# ==========================================================================
# Reply monitoring (IMAP)
# ==========================================================================

# IMAP host for the send-address mailbox. Gmail: imap.gmail.com.
# Read by: reply-monitor.yml
IMAP_HOST=

# Gmail App Password (IMAP-only, 16-char) for the send-address mailbox.
# Read by: reply-monitor.yml
IMAP_PASSWORD=

# Service account credentials JSON for the Gmail/Workspace domain
# (deliverability monitoring, DMARC report parsing).
# Read by: deliverability-monitor.yml
GOOGLE_CREDENTIALS_JSON=

# ==========================================================================
# Cross-repo access — SSOT (internal-docs)
# ==========================================================================

# PAT scoped to `contents: read` on <YOUR_ORG>/internal-docs. Reads the
# ICP criteria, both rubrics, and sequence templates at run time.
# feedback-loop.yml additionally needs contents:write + pull_requests:write
# to open the monthly rubric-proposal PR — provision a second PAT with
# elevated scope OR grant write on this one for that workflow only.
# Read by: pre-filter, enrichment, stack-profile, dedup-review,
#          sequence-enrollment, evergreen-nurture, feedback-loop,
#          judge-evals, weekly-crawl, event-ingest
INTERNAL_DOCS_PAT=

# ==========================================================================
# Slack
# ==========================================================================

# Bot token with chat:write on the ops + sales-review channels.
# Read by: smtp-send.yml, reply-monitor.yml, deliverability-monitor.yml,
#          pipeline-heartbeat.yml, judge-evals.yml
SLACK_BOT_TOKEN=

# Slack app signing secret — verifies the Cloudflare-Worker unsubscribe
# webhook's HMAC signature.
# Read by: cloudflare-worker-deploy.yml
SLACK_SIGNING_SECRET=

# Channel ID (starts C...) for pipeline alerts + verdict summaries.
SLACK_OPS_CHANNEL_ID=

# Channel ID for sales-review notifications (reply detected, send batch
# summary, deliverability warnings).
SLACK_SALES_REVIEW_CHANNEL=

# Slack user IDs (start U...) for reply-monitor DMs — the PM and the
# founder get direct-messaged on any inbound reply.
SLACK_PM_UID=
SLACK_FOUNDER_UID=

# ==========================================================================
# Cloudflare (unsubscribe webhook worker)
# ==========================================================================

# Account ID + API token for wrangler deploy of slack-webhook/.
# CAREFUL: run this on a company-owned Cloudflare account, not a personal
# one. Bus-factor risk otherwise.
# Read by: cloudflare-worker-deploy.yml
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ==========================================================================
# Fly.io (prior-contact lookup service)
# ==========================================================================

# API token for deploying inbox-agent/ to Fly.io.
# Read by: inbox-agent-deploy.yml
FLY_API_TOKEN=

# ==========================================================================
# Repo variables (set via `gh variable set`, not secrets)
# ==========================================================================

# "true" = global send hard-stop. smtp-send + warmup exit immediately.
# deliverability-monitor sets this on complaint-rate breach.
# SEQUENCES_PAUSED=false

# "true" = warmup ramp complete; smtp-send may lift its per-day cap to
# the full 100/day production rate. Set by warmup.yml on day 28.
# WARMUP_COMPLETE=false

# Comma-separated workflow filenames to mute in pipeline-heartbeat.yml.
# HEARTBEAT_SKIP=
