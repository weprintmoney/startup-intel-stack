# Python
__pycache__/
*.pyc
.venv/
venv/

# OS
.DS_Store

# Cross-repo symlink to the internal-docs SSOT — used at runtime but never committed.
internal-docs

# Environment
.env
.env.*
!.env.example

# Pipeline data (private-repo-only; never leaves this repo).
# The .gitkeep files under leads/ keep the directory structure but data
# stays local — enrichment/crawl/critic/etc. output goes uncommitted
# unless you explicitly override in your own workflow.
leads/**/*.json
leads/**/*.csv
leads/**/*.md
!leads/**/.gitkeep

# Send state — regenerated by the pipeline, never in git.
sends/queue/*
sends/log/*
sends/verdicts/*
sends/rejected/*
!sends/queue/.gitkeep
!sends/log/.gitkeep
!sends/verdicts/.gitkeep
!sends/rejected/.gitkeep

# Runtime warmup + feedback outputs
warmup/log/*
!warmup/log/.gitkeep
feedback/reports/*.md
!feedback/reports/.gitkeep

# Suppression list — a live blocklist; commit-conflicts corrupt it. Treat as
# runtime state and merge conflicts by hand from Slack notifications instead.
suppression/list.jsonl
