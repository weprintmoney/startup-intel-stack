# agent-ops secrets & variables
#
# GitHub Actions reads these from repo Secrets and repo Variables. This file
# is documentation — never commit a filled copy. Provisioning steps live in
# SETUP.md.
#
# =========================================================================
# Anthropic
# =========================================================================

# Pipeline agents (implementer, reviewers, judges, dream miners, ticket
# drafter, release-intelligence miner, spec drafter). Dedicated key so
# cost-digest can attribute spend cleanly against other loops.
# Read by: implement.yml, code-judge.yml, judge-evals.yml, dream.yml,
# spec-draft.yml, ticket-intake.yml, release-intelligence.yml
ANTHROPIC_API_KEY=

# Admin API key for the org cost-report endpoint (Console -> Settings ->
# Admin keys). Only cost-digest.yml touches this — do NOT reuse the
# pipeline API key.
# Read by: cost-digest.yml
ANTHROPIC_ADMIN_KEY=

# =========================================================================
# Slack
# =========================================================================

# Bot token with chat:write on the ops channel. Post-only.
# Read by: every workflow via scripts/slack-alert.sh (pipeline-heartbeat,
# cost-digest, dream, code-judge, ticket-intake, spec-draft, implement,
# metrics-digest, ledger-update, release-intelligence, judge-evals,
# expertise-path-guard, footprint-scan)
SLACK_BOT_TOKEN=

# Ops channel ID (Slack channel ID starting C...). All pipeline alerts
# land here. Bot must be invited before any workflow will post.
SLACK_OPS_CHANNEL_ID=

# Optional: exec / leadership channel ID. The pipeline never posts here.
# Set it so scripts/slack-alert.sh can hard-refuse posts to this ID as a
# defense-in-depth check.
SLACK_EXEC_CHANNEL_ID=

# =========================================================================
# GitHub PATs (all owned by the bot account — see SETUP.md #2)
# =========================================================================

# Read-only internal-docs (contents:read). Every task agent uses this to
# sparse-check-out the SSOT for grounding.
# Read by: spec-draft.yml, implement.yml, code-judge.yml,
# judge-evals.yml, release-intelligence.yml
INTERNAL_DOCS_RO_PAT=

# Contents + PR write on internal-docs. Dream loop ONLY — this is the only
# token in the system that can write to shared memory, and it never leaves
# dream.yml.
# Read by: dream.yml
INTERNAL_DOCS_PR_PAT=

# Contents + PR write on the product repo(s). Implementer opens PRs here;
# code-judge writes commit status here. Consider adding "organization
# project" scope so release-intelligence tickets can land on the sprint
# project (degrades to label-only with a warning otherwise).
# Read by: implement.yml, code-judge.yml, release-intelligence.yml
PRODUCT_REPOS_PAT=

# Read-only <YOUR_ORG>/sales-ops (contents:read). Release-intelligence
# prospect-name guard fetches guards/prospect-names.txt at run time. Fail
# closed — no token, no tickets.
# Read by: release-intelligence.yml
SALES_OPS_RO_PAT=

# Read-only agent-ops itself (contents + actions read). Used by workflows
# that need to inspect other workflows' state or read this repo's own
# files via API (cost-digest inspects billing; heartbeat inspects runs).
# Read by: cost-digest.yml, pipeline-heartbeat.yml
AGENT_OPS_READ_TOKEN=

# =========================================================================
# Repo variables (set via `gh variable set`, not secrets)
# =========================================================================

# "true" = global hard-stop. Every non-exempt workflow must exit
# immediately. cost-digest sets this at 100% of weekly ceiling.
# Read by: ticket-intake.yml, spec-draft.yml, implement.yml, dream.yml
AGENT_OPS_PAUSED=false

# "true" = auto-merge is refused at every autonomy level. judge-evals sets
# this on a golden-set verdict flip; only a human clears it.
# Read by: code-judge.yml (auto-merge arming step)
AUTO_MERGE_FROZEN=false

# Weekly dollar ceiling (integer USD, no symbol). 70% warns, 100%
# hard-stops.
# Read by: cost-digest.yml
WEEKLY_COST_CEILING_USD=150

# Comma-separated workflow filenames to mute in the heartbeat. Cheaper than
# commenting out invariants and forgetting to restore them.
# Read by: pipeline-heartbeat.yml
HEARTBEAT_SKIP=
