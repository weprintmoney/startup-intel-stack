# agent-ops secrets & variables
#
# GitHub Actions reads these from repo Secrets and repo Variables. This file
# is documentation — never commit a filled copy. Provisioning steps live in
# SETUP.md.
#
# =========================================================================
# Anthropic
# =========================================================================

# Pipeline agents (implementer, reviewers, judges, dream miners, ticket
# drafter, release-intelligence miner, spec drafter). Dedicated key so
# cost-digest can attribute spend cleanly against other loops.
# Read by: implement.yml, code-judge.yml, judge-evals.yml, dream.yml,
# spec-draft.yml, ticket-intake.yml, release-intelligence.yml
ANTHROPIC_API_KEY=

# Optional Admin API key for the org cost-report endpoint (Console ->
# Settings -> Admin keys). If unset, the cost workflows fall back to
# ANTHROPIC_API_KEY when its scope covers the cost-report endpoint.
# Read by: cost-digest.yml, metrics-digest.yml, budget-guard.yml
ANTHROPIC_ADMIN_KEY=

# =========================================================================
# Slack
# =========================================================================

# Bot token with chat:write on the ops channel. Post-only.
# Read by: every workflow via scripts/slack-alert.sh (pipeline-heartbeat,
# cost-digest, dream, code-judge, ticket-intake, spec-draft, implement,
# metrics-digest, ledger-update, release-intelligence, judge-evals,
# expertise-path-guard, footprint-scan)
SLACK_BOT_TOKEN=

# Ops channel ID (Slack channel ID starting C...). All pipeline alerts
# land here. Bot must be invited before any workflow will post.
SLACK_OPS_CHANNEL_ID=

# Optional: exec / leadership channel ID. The pipeline never posts here.
# Set it so scripts/slack-alert.sh can hard-refuse posts to this ID as a
# defense-in-depth check.
SLACK_EXEC_CHANNEL_ID=

# =========================================================================
# GitHub App (see SETUP.md #1-#2 and docs/github-app-setup.md)
# =========================================================================

# Client ID of the example-app-bot GitHub App. Not secret — set it as a repo
# VARIABLE. Every workflow mints short-lived installation tokens from it via
# actions/create-github-app-token, scoped inline to the repos and permissions
# that job needs (replaces the old internal-docs / product-repo / sales-ops
# PAT matrix).
BOT_APP_CLIENT_ID=

# The App's private key: entire .pem contents. Repo SECRET on agent-ops only,
# never org-wide.
BOT_APP_PRIVATE_KEY=

# Optional: read-only token used by the reusable guards when a PUBLIC caller
# repo must fetch a script from this private repo (expertise-path-guard,
# footprint-scan). Fails closed without it.
AGENT_OPS_READ_TOKEN=

# =========================================================================
# Repo variables (set via `gh variable set`, not secrets)
# =========================================================================

# "true" = global hard-stop. Every non-exempt workflow must exit
# immediately. Human-set; budget-guard.yml also sets it at the ceiling once
# the App holds "Variables: read/write" (until then it alerts).
# Read by: ticket-intake.yml, spec-draft.yml, implement.yml, dream.yml
AGENT_OPS_PAUSED=false

# "true" = auto-merge is refused at every autonomy level. judge-evals sets
# this on a golden-set verdict flip; only a human clears it.
# Read by: code-judge.yml (auto-merge arming step)
AUTO_MERGE_FROZEN=false

# Weekly dollar ceiling (integer USD, no symbol). 70% warns, 100%
# hard-stops (budget-guard.yml checks every 15 minutes).
# Read by: cost-digest.yml, budget-guard.yml
WEEKLY_COST_CEILING_USD=150

# The Anthropic workspace the pipeline key runs under. Spend checks are
# scoped to it so interactive use never trips the pipeline's ceiling.
# Read by: cost-digest.yml, metrics-digest.yml, budget-guard.yml
ANTHROPIC_WORKSPACE_ID=

# "true" = spec-only harvest: a merged spec PR abandons the claim instead of
# dispatching implement.yml. Silent if left on — check it first when specs
# merge and nothing implements.
# Read by: spec-pending-reap.yml, spec-draft.yml
DRAIN_MODE=false

# "act" = dependabot-triage may label/approve/merge per
# state/dependabot-repos.json; anything else = observe only.
# Read by: dependabot-triage.yml
DEPENDABOT_MODE=

# Optional: path of your developer guide in internal-docs, for
# docs-sync-check.yml (default 07-engineering-docs/development/agent-ops/reference.md).
DEV_GUIDE_PATH=

# Comma-separated workflow filenames to mute in the heartbeat. Cheaper than
# commenting out invariants and forgetting to restore them.
# Read by: pipeline-heartbeat.yml
HEARTBEAT_SKIP=
