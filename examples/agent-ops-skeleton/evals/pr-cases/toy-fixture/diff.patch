@@ -12,10 +12,17 @@ from example_app.errors import WorkspaceNotFound
 def resolve_workspace_slug(request):
     """Resolve the workspace slug for the current request.

-    Returns the slug string, or raises WorkspaceNotFound if the user has
-    no default workspace configured.
+    Returns:
+        - The slug string for an authenticated user with a default workspace.
+        - ``None`` for an unauthenticated request (``request.user is None``);
+          the caller is expected to let the framework's 401 handler run.
+
+    Raises:
+        WorkspaceNotFound: if the user is authenticated but has no default
+        workspace configured.
     """
-    user = request.user
+    if getattr(request, "user", None) is None:
+        return None
+    user = request.user
     if user.default_workspace_id is None:
         raise WorkspaceNotFound(user_id=user.id)
     return user.default_workspace.slug
